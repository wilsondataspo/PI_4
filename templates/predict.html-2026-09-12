{% extends "base.html" %}
{% block title %}Previsão{% endblock %}

{% block content %}
<h1 class="mb-4">Previsão para Novo Cliente</h1>
<p>Preencha os dados do cliente para estimar a probabilidade de renovação.</p>

<form id="predictForm" class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Idade</label>
        <input type="number" class="form-control" name="age" min="18" max="80" value="30" required>
    </div>
    <div class="col-md-6">
        <label class="form-label">Gênero</label>
        <select class="form-select" name="gender">
            <option>Masculino</option>
            <option>Feminino</option>
        </select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Meses de assinatura</label>
        <input type="number" class="form-control" name="membership_months" min="1" max="60" value="12" required>
    </div>
    <div class="col-md-6">
        <label class="form-label">Visitas por semana</label>
        <input type="number" class="form-control" name="visits_per_week" min="0" max="7" step="1" value="3" required>
    </div>

    <div class="col-md-6">
        <label class="form-label">Tempo médio por visita (min)</label>
        <input type="number" class="form-control" name="avg_time_spent" min="0" max="180" value="60" required>
    </div>
    <div class="col-md-6">
        <label class="form-label">Nível de condicionamento (1-5)</label>
        <input type="number" class="form-control" name="fitness_level" min="1" max="5" value="3" required>
    </div>

    <div class="col-md-6">
        <label class="form-label">Tipo de plano</label>
        <select class="form-select" name="plan_type">
            <option>Básico</option>
            <option>Standard</option>
            <option>Premium</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Mensalidade (R$)</label>
        <input type="number" class="form-control" name="monthly_fee" min="0" max="500" value="100" required>
    </div>

    <div class="col-md-6">
        <label class="form-label">Participa de aulas coletivas?</label>
        <select class="form-select" name="attended_group_classes">
            <option value="0">Não</option>
            <option value="1">Sim</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Sessões com personal trainer</label>
        <input type="number" class="form-control" name="pt_sessions" min="0" max="50" value="0" required>
    </div>

    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary btn-lg">Prever Renovação</button>
    </div>
</form>

<div id="result" class="mt-4"></div>

{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/predict.js') }}"></script>
{% endblock %}